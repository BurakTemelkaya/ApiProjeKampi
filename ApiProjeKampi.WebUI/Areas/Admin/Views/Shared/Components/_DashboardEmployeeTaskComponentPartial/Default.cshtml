@model List<ResultEmployeeTaskDto>
@{
    int chefCount = 0;
}


<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h4>Assign Task Table</h4>
                <div class="card-header-form">
                    <form>
                        <div class="input-group">
                            <input type="text" class="form-control" placeholder="Search">
                            <div class="input-group-btn">
                                <button class="btn btn-primary"><i class="fas fa-search"></i></button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped">
                        <tr>
                            <th class="text-center">
                                <div class="custom-checkbox custom-checkbox-table custom-control">
                                    <input type="checkbox" data-checkboxes="mygroup" data-checkbox-role="dad"
                                           class="custom-control-input" id="checkbox-all">
                                    <label for="checkbox-all" class="custom-control-label">&nbsp;</label>
                                </div>
                            </th>
                            <th>Görev İsmi</th>
                            <th>Şefler</th>
                            <th>Görev Durunu</th>
                            <th>Atama Tarihi</th>
                            <th>Bitiş Tarihi</th>
                            <th>Önem Derecesi</th>
                            <th>İşlemler</th>
                        </tr>

                        @foreach (ResultEmployeeTaskDto employeeTask in Model)
                        {
                            <tr>
                                <td class="p-0 text-center">
                                    <div class="custom-checkbox custom-control">
                                        <input type="checkbox" data-checkboxes="mygroup" class="custom-control-input"
                                               id="checkbox-1">
                                        <label for="checkbox-1" class="custom-control-label">&nbsp;</label>
                                    </div>
                                </td>
                                <td>@employeeTask.TaskName</td>
                                <td class="text-truncate">
                                    <ul class="list-unstyled order-list m-b-0 m-b-0">
                                        @foreach (var employeeTaskChef in employeeTask.EmployeeTaskChefs)
                                        {
                                            chefCount++;
                                            if (chefCount >= 4)
                                            {
                                                break;
                                            }
                                            <li class="team-member team-member-sm">
                                                <img class="rounded-circle"
                                                     src="@employeeTaskChef.Chef.ImageUrl" alt="user" data-toggle="tooltip" title=""
                                                     data-original-title="@employeeTaskChef.Chef.NameSurname">
                                            </li>
                                        }
                                        <li class="avatar avatar-sm"><span class="badge badge-primary">+ @(employeeTask.EmployeeTaskChefs.Count - 4)</span></li>
                                    </ul>
                                </td>
                                <td class="align-middle">
                                    <div class="progress-text">@employeeTask.TaskStatusValue%</div>
                                    <div class="progress" data-height="6">
                                        <div class="progress-bar bg-success" data-width="@employeeTask.TaskStatusValue%"></div>
                                    </div>
                                </td>
                                <td>@employeeTask.AssignDate.ToShortDateString()</td>
                                <td>@employeeTask.DueDate.ToShortDateString()</td>
                                <td>
                                    <div class="badge badge-success">@employeeTask.Priority</div>
                                </td>
                                <td><a href="#" class="btn btn-outline-primary">İşlemler</a></td>
                            </tr>
                        }


                    </table>
                </div>
            </div>
        </div>
    </div>
</div>