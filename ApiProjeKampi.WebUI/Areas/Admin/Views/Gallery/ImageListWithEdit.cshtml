
@{
    ViewData["Title"] = "ImageListWithEdit";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

@model List<ResultImageDto>

<div class="row">
    <div class="col-12 col-md-12 col-lg-12">
        <div class="card">
            <div class="card-header">
                <h4>Görsel Listesi</h4>
            </div>
            <div class="card-body">
                <table class="table">
                    <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Görsel Başlığı</th>
                            <th scope="col">Sil</th>
                            <th scope="col">Güncelle</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var image in Model)
                        {
                            count++;
                            <tr>
                                <th scope="row">@count</th>
                                <td>@image.Title</td>
                                <td><a asp-action="DeleteImage" asp-controller="Gallery" asp-area="@AreaNames.Admin" asp-route-id="@image.ImageId" class="btn btn-danger">Sil</a></td>
                                <td><a asp-action="UpdateImage" asp-controller="Gallery" asp-area="@AreaNames.Admin" asp-route-id="@image.ImageId" class="btn btn-success">Güncelle</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
                <a asp-action="CreateImage" asp-controller="Gallery" asp-area="@AreaNames.Admin" class="btn btn-primary">Yeni Görsel Ekle</a>
            </div>
        </div>
    </div>
</div>